  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Gameplay-Dialog-Text-Localized_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: b7e5c2e54d59cef52b56c6b356f3e737, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 63058197209686032
    m_Localized: About your team
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585536
    m_Localized: "I\u2019m the captain of the Saint Justice team."
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686028
    m_Localized: Play Secret Road
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686029
    m_Localized: About the match
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686030
    m_Localized: About you
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686031
    m_Localized: About this place
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686027
    m_Localized: Play match
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585547
    m_Localized: Mercapingo is the most popular supermarket around.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585546
    m_Localized: Mercapingo sells everything, from food to accessories.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585545
    m_Localized: I punish bad girls.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585544
    m_Localized: I'm the coolest guy in town.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585543
    m_Localized: We study paranormal activities here.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585542
    m_Localized: This is the UFO Club.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585541
    m_Localized: I study UFO sightings in the park.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585540
    m_Localized: The school has its own church.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585539
    m_Localized: I like drawing.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585538
    m_Localized: "It\u2019s well known throughout the city."
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585537
    m_Localized: This school is very prestigious.
    m_Metadata:
      m_Items: []
  - m_Id: 63058161876869123
    m_Localized: The chest is locked. You need a key.
    m_Metadata:
      m_Items: []
  - m_Id: 63058161876869122
    m_Localized: The chest is empty.
    m_Metadata:
      m_Items: []
  - m_Id: 63058161876869121
    m_Localized: You found {chest_item_name}!
    m_Metadata:
      m_Items: []
  - m_Id: 63058161876869120
    m_Localized: You open the chest...
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686025
    m_Localized: Confess
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686026
    m_Localized: You won't get away with this!
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952769
    m_Localized: Hello!
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952768
    m_Localized: Greetings!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194824
    m_Localized: See you later!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194823
    m_Localized: Go in peace.
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194822
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194821
    m_Localized: Come back soon!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194820
    m_Localized: Get out of my sight!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194819
    m_Localized: Take care!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194818
    m_Localized: Bye!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194817
    m_Localized: Goodbye!
    m_Metadata:
      m_Items: []
  - m_Id: 63058248380194816
    m_Localized: Farewell!
    m_Metadata:
      m_Items: []
  - m_Id: 63058233347809280
    m_Localized: The door is locked.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779901
    m_Localized: find the shards of the Spirit of Soccer to awaken.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779900
    m_Localized: Create your dream team and
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779899
    m_Localized: I'm afraid the simulation is in debug mode and trying to kill us
      both.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779898
    m_Localized: This is not the real world. It is a simulation.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779897
    m_Localized: I have come here to help you.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779896
    m_Localized: Eventually, everything on the screen is covered in blood.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779895
    m_Localized: His arm is gone, and blood pours from the mangled wound.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779894
    m_Localized: The screen shows a man in a white room.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779893
    m_Localized: It's the dam's manual control panel.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779892
    m_Localized: The machine is broken.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779891
    m_Localized: A strange machine is connected to the bed.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779890
    m_Localized: It's a spooky skeleton.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779889
    m_Localized: We'll blow you to smithereens.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779888
    m_Localized: Impressive. You reached the Simulation Node, but you're too late.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779887
    m_Localized: We rule the world and maintain order.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779886
    m_Localized: I'm the captain of the Great Crimson.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779885
    m_Localized: Now the Simulation Node will steal Satu's evil power and grow stronger.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779884
    m_Localized: You've fallen into our trap.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779883
    m_Localized: Thank you for saving the village.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779882
    m_Localized: These islands were formed as lava and ash from eruptions built up
      over time.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779881
    m_Localized: Five hundred years ago, an eruption destroyed this village.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779880
    m_Localized: There have been many earthquakes lately. I'm afraid the volcano
      may erupt.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779879
    m_Localized: Black Cube Co. is northeast of here. Mercapingo is to the east.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779878
    m_Localized: The power supply has been restored.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779877
    m_Localized: There have been so many blackouts lately. I wonder what's happening
      at Black Cube Co.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779876
    m_Localized: I love playing soccer in the park.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779875
    m_Localized: This is terrible. A train was hijacked, and it could derail.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779874
    m_Localized: I love the smell of flowers.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779873
    m_Localized: Oh no! The dam is open, and a flood is coming. The whole city may
      flood.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779872
    m_Localized: Count on us. We'll help you.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779871
    m_Localized: I'm the captain of the team and the group's main singer.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779870
    m_Localized: Every player is a girl, and we even have our own girl group.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779869
    m_Localized: Witness the power of idols. This exhibition will show our true strength.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779868
    m_Localized: Actually... I've changed my mind. I'll help you.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779867
    m_Localized: That's it. I'm quitting the team.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779866
    m_Localized: We're just a small neighborhood team, not Saint Justice's team.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779865
    m_Localized: I don't feel good about facing this opponent. You can take my place.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779864
    m_Localized: The park is west of here.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779863
    m_Localized: Giant Turtle will face Secret Girls.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779862
    m_Localized: An exhibition match is coming up at Saint Justice, northeast of
      here.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779861
    m_Localized: Thank you for saving our village.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779860
    m_Localized: I can only watch and wonder if there's anything I can do.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779859
    m_Localized: What good is peace when the volcano could destroy our village?
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779858
    m_Localized: The sea looks so peaceful, yet I can't shake this fear.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779857
    m_Localized: I work at the power plant.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779856
    m_Localized: I have the power to generate electricity.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779855
    m_Localized: Thank you for saving me.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779854
    m_Localized: I'm very sad.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779853
    m_Localized: Help me!
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779852
    m_Localized: Thank you for saving my family.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779851
    m_Localized: But now, the place is almost abandoned.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779850
    m_Localized: This train station used to be luxurious.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779849
    m_Localized: I work making sandwiches at the train station.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779848
    m_Localized: My family is on the train.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779847
    m_Localized: Please help me!
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779846
    m_Localized: Thank you for saving me.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779845
    m_Localized: Help me!
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779844
    m_Localized: I'll use my strength to cause a volcanic eruption.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779843
    m_Localized: The village will burn down.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779842
    m_Localized: The White Room is where Black Cube Co. performs its rituals.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779841
    m_Localized: That way, she can't generate electricity.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213487779840
    m_Localized: I'm showing her disgusting images to break her spirit.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585566
    m_Localized: An endless blackout...
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585565
    m_Localized: I'll derail the hijacked train with a powerful shot.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585564
    m_Localized: I'll derail the train.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585563
    m_Localized: Soon, this entire city will be beneath the floodwaters.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585562
    m_Localized: I'm also guarding the dam's manual control mechanism.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585561
    m_Localized: I have kidnapped the dam chief's son to keep the dam open and flood
      the city.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585560
    m_Localized: This replica exists within the simulation.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585559
    m_Localized: The Crimson Cube teleports us to a replica of the Corrupted Soccer
      Realm.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585558
    m_Localized: The Crimson Cube teleports us to a replica of the Corrupted Soccer
      Realm in the simulation.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585557
    m_Localized: Crimson Cube activated!
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585556
    m_Localized: HP and SP restored.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585555
    m_Localized: Confess your sins.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585554
    m_Localized: The fact that you can see me means you are truly strong.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585553
    m_Localized: Be careful. The road is in bad shape, and the area is dirty.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585552
    m_Localized: The train station is northwest of here.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585551
    m_Localized: I hope nothing bad happens in the future.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585550
    m_Localized: I usually walk along this walkway.
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585549
    m_Localized: Don't tell anyone about this, okay...?
    m_Metadata:
      m_Items: []
  - m_Id: 63058213483585548
    m_Localized: I come here to eat delicious food...
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686024
    m_Localized: Pray
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686023
    m_Localized: Goodbye
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686022
    m_Localized: Back
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686021
    m_Localized: Cancel
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686020
    m_Localized: Leave
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686019
    m_Localized: Sell
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686018
    m_Localized: Buy
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686017
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 63058197209686016
    m_Localized: Yes
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952770
    m_Localized: Hi!
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952771
    m_Localized: What do you want?
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952772
    m_Localized: How can I help you?
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952773
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952774
    m_Localized: Welcome!
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952775
    m_Localized: Peace be with you.
    m_Metadata:
      m_Items: []
  - m_Id: 63058268881952776
    m_Localized: Prepare yourself!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505018892288
    m_Localized: You got lucky... Take this.
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086592
    m_Localized: You got me... Take this.
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086593
    m_Localized: You beat me... Take this.
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086594
    m_Localized: You got me... Take this.
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086595
    m_Localized: Next time, you'll drown!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086596
    m_Localized: Next time, I'll crush you!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086597
    m_Localized: Next time, darkness will consume you!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086598
    m_Localized: Next time, I'll burn you alive!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086599
    m_Localized: You found a Shard of Sorrow!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086600
    m_Localized: You found a Shard of Fear!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086601
    m_Localized: You found a Shard of Hatred!
    m_Metadata:
      m_Items: []
  - m_Id: 63318505023086602
    m_Localized: You found a Shard of Anger!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

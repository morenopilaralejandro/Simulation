%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Gameplay-Dialog-Text-Romanized_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 20eafc7676cc8a7f583d02b667230b3c, type: 2}
  m_Metadata:
    m_Items:
    - rid: 6474107469045432324
  m_TableData:
  - m_Id: 63058212963491840
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 63058212959297536
    m_Localized: "S\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 4266809588719616
    m_Localized: Abres el cofre...
    m_Metadata:
      m_Items: []
  - m_Id: 4266809592913920
    m_Localized: "\xA1Obtuviste {chest_item_name}!"
    m_Metadata:
      m_Items:
      - rid: 6474107469045432324
  - m_Id: 4266809592913921
    m_Localized: "El cofre est\xE1 vac\xEDo."
    m_Metadata:
      m_Items: []
  - m_Id: 4266809592913922
    m_Localized: Cofre bloqueado. Necesitas una llave.
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491841
    m_Localized: Comprar
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491842
    m_Localized: Vender
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491843
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491844
    m_Localized: Cancelar
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491845
    m_Localized: Volver
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491846
    m_Localized: "Adi\xF3s"
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491847
    m_Localized: Rezar
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491848
    m_Localized: Confesarse
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491849
    m_Localized: "\xA1No te lo permitir\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491850
    m_Localized: Jugar partido
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491851
    m_Localized: Jugar Senda Secreta
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491852
    m_Localized: Sobre el partido
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491853
    m_Localized: Sobre ti
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491854
    m_Localized: Sobre este lugar
    m_Metadata:
      m_Items: []
  - m_Id: 63058212963491855
    m_Localized: Sobre tu equipo
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911552
    m_Localized: Soy la capitana del equipo San Justo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911553
    m_Localized: Esta escuela tiene mucho prestigio.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911554
    m_Localized: Es muy conocida en toda la ciudad.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911555
    m_Localized: Me gusta dibujar.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911556
    m_Localized: La escuela tiene su propia iglesia.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911557
    m_Localized: Estudio avistamientos de ovnis en el parque.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911558
    m_Localized: Este es el Club de ovnis.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911559
    m_Localized: "Aqu\xED estudiamos fen\xF3menos paranormales."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911560
    m_Localized: "Soy el m\xE1s chulo de la ciudad."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911561
    m_Localized: Castigo a las chicas malas.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911562
    m_Localized: Mercapingo vende de todo, desde comida hasta accesorios.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911563
    m_Localized: "Mercapingo es el supermercado m\xE1s popular de la zona."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911564
    m_Localized: "Vengo aqu\xED para comer comida deliciosa..."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911565
    m_Localized: "No se lo digas a nadie, \xBFvale...?"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911566
    m_Localized: "Suelo pasear por aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911567
    m_Localized: Espero que no pase nada malo en el futuro.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911568
    m_Localized: "La estaci\xF3n de tren est\xE1 al noroeste de aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911569
    m_Localized: "Ten cuidado. La carretera est\xE1 en mal estado y la estaci\xF3n
      est\xE1 sucia."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911570
    m_Localized: Que puedas verme significa que eres realmente fuerte.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911571
    m_Localized: Confiesa tus pecados.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911572
    m_Localized: PS y PT restaurados.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911573
    m_Localized: "\xA1Cubo Carmes\xED activado!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911574
    m_Localized: "El Cubo Carmes\xED nos teletransporta a una r\xE9plica del Reino
      del F\xFAtbol Corrompido en la simulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911575
    m_Localized: "El Cubo Carmes\xED nos teletransporta a una r\xE9plica del Reino
      del F\xFAtbol Corrompido."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911576
    m_Localized: "Esta r\xE9plica existe dentro de la simulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911577
    m_Localized: He secuestrado al hijo del jefe de la presa para mantenerla abierta
      e inundar la ciudad.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911578
    m_Localized: "Tambi\xE9n estoy vigilando el mecanismo manual de control de la
      presa."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911579
    m_Localized: "Pronto, toda esta ciudad quedar\xE1 bajo las aguas."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911580
    m_Localized: "Har\xE9 descarrilar el tren."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911581
    m_Localized: "Har\xE9 descarrilar el tren secuestrado con un potente disparo."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911582
    m_Localized: "Un apag\xF3n interminable..."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911583
    m_Localized: "Le muestro im\xE1genes repugnantes para deprimirla."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911584
    m_Localized: "\u305D\u3046\u3059\u308C\u3070\u3001\u5F7C\u5973\u306F\u96FB\u6C17\u3092\u751F\u307F\u51FA\u305B\u306A\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911585
    m_Localized: La Sala Blanca es donde Black Cube S.A. realiza sus rituales.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911586
    m_Localized: "El pueblo arder\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911587
    m_Localized: "Usar\xE9 mi fuerza para provocar una erupci\xF3n volc\xE1nica."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911588
    m_Localized: "\xA1Ay\xFAdame!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911589
    m_Localized: Gracias por salvarme.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911590
    m_Localized: "\xA1Por favor, ay\xFAdame!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911591
    m_Localized: "Mi familia est\xE1 en el tren."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911592
    m_Localized: "Trabajo preparando s\xE1ndwiches en la estaci\xF3n de tren."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911593
    m_Localized: "Esta estaci\xF3n de tren sol\xEDa ser lujosa."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911594
    m_Localized: "Pero ahora, el lugar est\xE1 casi abandonado."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911595
    m_Localized: Gracias por salvar a mi familia.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911596
    m_Localized: "\xA1Ay\xFAdame!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911597
    m_Localized: Estoy muy triste.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911598
    m_Localized: Gracias por salvarme.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911599
    m_Localized: Tengo el poder de generar electricidad.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911600
    m_Localized: "Trabajo en la central el\xE9ctrica."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911601
    m_Localized: El mar parece tan tranquilo, pero no puedo librarme de este miedo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911602
    m_Localized: "\xBFDe qu\xE9 sirve la calma si el volc\xE1n puede destruir nuestro
      pueblo?"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911603
    m_Localized: Solo puedo mirar y preguntarme si hay algo que pueda hacer.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911604
    m_Localized: Gracias por salvar nuestro pueblo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911605
    m_Localized: "Habr\xE1 un partido de exhibici\xF3n en San Justo, al noreste de
      aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911606
    m_Localized: "Tortuga Gigante se enfrentar\xE1 a Secret Girls."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911607
    m_Localized: "El parque est\xE1 al oeste de aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911608
    m_Localized: "No me siento bien enfrent\xE1ndome a ese rival. Puedes ocupar mi
      lugar."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911609
    m_Localized: "Solo somos un peque\xF1o equipo del barrio, no el equipo de San
      Justo."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911610
    m_Localized: "Ya est\xE1. Dejo el equipo."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911611
    m_Localized: "En realidad... he cambiado de opini\xF3n. Te ayudar\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911612
    m_Localized: "Contempla el poder de las idols. Este partido mostrar\xE1 nuestra
      fuerza."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911613
    m_Localized: Todas las jugadoras son chicas, y hasta tenemos nuestro propio grupo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911614
    m_Localized: Soy la capitana del equipo y la cantante principal del grupo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911615
    m_Localized: Cuenta con nosotras. Te ayudaremos.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911616
    m_Localized: "\xA1Oh, no! La presa est\xE1 abierta y viene una inundaci\xF3n.
      La ciudad podr\xEDa anegarse."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911617
    m_Localized: Me encanta el aroma de las flores.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911618
    m_Localized: "Es terrible. Han secuestrado un tren y podr\xEDa descarrilar."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911619
    m_Localized: "Me encanta jugar al f\xFAtbol en el parque."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911620
    m_Localized: "\xDAltimamente hay muchos apagones. Me pregunto qu\xE9 pasa en
      Black Cube S.A."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911621
    m_Localized: "El suministro el\xE9ctrico ha sido restablecido."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911622
    m_Localized: "Black Cube S.A. est\xE1 al noreste. Mercapingo queda al este."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911623
    m_Localized: "Ha habido muchos terremotos. Me temo que el volc\xE1n vaya a entrar
      en erupci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911624
    m_Localized: "Hace quinientos a\xF1os, una erupci\xF3n destruy\xF3 este pueblo."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911625
    m_Localized: Estas islas surgieron cuando lava y ceniza se acumularon durante
      erupciones.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911626
    m_Localized: Gracias por salvar el pueblo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911627
    m_Localized: "Han ca\xEDdo en nuestra trampa."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911628
    m_Localized: "Ahora el Nodo de Simulaci\xF3n robar\xE1 el poder maligno de Satu."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911629
    m_Localized: "Soy el capit\xE1n de los Great Crimson."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911630
    m_Localized: Gobernamos el mundo y mantenemos el orden.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911631
    m_Localized: "Impresionante. Llegaste al Nodo de Simulaci\xF3n, pero es demasiado
      tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911632
    m_Localized: Los haremos volar en pedazos.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911633
    m_Localized: Es un esqueleto espeluznante.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911634
    m_Localized: "Hay una extra\xF1a m\xE1quina conectada a la cama."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911635
    m_Localized: "La m\xE1quina est\xE1 averiada."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911636
    m_Localized: Es el panel de control manual de la presa.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911637
    m_Localized: La pantalla muestra a un hombre en una sala blanca.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911638
    m_Localized: Ha perdido un brazo y la sangre brota de la grave herida.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911639
    m_Localized: Al final, todo lo que aparece en la pantalla queda cubierto de sangre.
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911640
    m_Localized: "He venido aqu\xED para ayudarte."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911641
    m_Localized: "Este no es el mundo real. Es una simulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241077911642
    m_Localized: "Me temo que la simulaci\xF3n est\xE1 en modo depuraci\xF3n e intenta
      matarnos."
    m_Metadata:
      m_Items: []
  - m_Id: 63058241082105856
    m_Localized: "Crea el equipo de tus sue\xF1os y"
    m_Metadata:
      m_Items: []
  - m_Id: 63058241082105857
    m_Localized: "encuentra los fragmentos del Esp\xEDritu del F\xFAtbol para despertar."
    m_Metadata:
      m_Items: []
  - m_Id: 63058255103664128
    m_Localized: "La puerta est\xE1 cerrada con llave."
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464896
    m_Localized: "\xA1Adi\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464897
    m_Localized: "\xA1Adi\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464898
    m_Localized: "\xA1Adi\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464899
    m_Localized: "\xA1Cu\xEDdate!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464900
    m_Localized: "\xA1Fuera de mi vista!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464901
    m_Localized: "\xA1Vuelve pronto!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464902
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464903
    m_Localized: Vete en paz.
    m_Metadata:
      m_Items: []
  - m_Id: 63058271008464904
    m_Localized: "\xA1Hasta luego!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914304
    m_Localized: "\xA1Saludos!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914305
    m_Localized: "\xA1Hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914306
    m_Localized: "\xA1Hola!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914307
    m_Localized: "\xBFQu\xE9 quieres?"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914308
    m_Localized: "\xBFEn qu\xE9 puedo ayudarte?"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914309
    m_Localized: "\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914310
    m_Localized: "\xA1Bienvenido!"
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914311
    m_Localized: La paz sea contigo.
    m_Metadata:
      m_Items: []
  - m_Id: 63058284962914312
    m_Localized: "\xA1Prep\xE1rate!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds:
    - rid: 6474107469045432324
      type: {class: SmartFormatTag, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_Entries: 
        m_SharedEntries:
        - id: 4266809592913920
